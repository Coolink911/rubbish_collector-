# Every line here is optional. Copy to .env and the app runs as-is on a local
# SQLite file. .env is gitignored - never commit the real one.

# Unset -> ./data/binrun.db (SQLite, fine locally).
# The DEPLOYED instance must set this to a hosted Postgres (Neon), because the
# Space's filesystem is wiped on restart. Set it as a Space secret, not here.
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Signs the session cookie. Generate one:
#   python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=change-me

# Turns "3 bags of garden stuff, 14 Rosmead Ave, tomorrow morning" into form
# fields. Without it the form is filled in by hand and nothing else changes.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5

# OpenStreetMap asks that you identify yourself. Free, rate-limited (1 req/s).
# NOMINATIM_USER_AGENT=binrun/0.1 (you@example.com)
# GEOCODE_ENABLED=1
# GEOCODE_TIMEOUT=6

# Point the test suite at a throwaway Postgres to run it on the deployed
# engine instead of temp SQLite files:
# TEST_DATABASE_URL=postgresql://...
