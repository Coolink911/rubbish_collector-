# Copy to .env and fill in. .env is gitignored - never commit the real one.

# Neon connection string. Dashboard -> your project -> Connection Details.
# Looks like: postgresql://user:password@ep-something.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Signs the session cookie. Any long random string; generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
